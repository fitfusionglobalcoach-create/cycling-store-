{%- assign s = section.settings -%}
<section class="lo-community lo-scheme-{{ s.scheme }}">
  <div class="lo-wrap">
    <div class="lo-section-head lo-section-head--split" data-lo-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<p class="lo-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="lo-btn lo-btn--ghost">{{ s.button_label }}</a>{%- endif -%}
    </div>
    <div class="lo-community__grid">
      {%- for block in section.blocks -%}
        <figure class="lo-community__item" data-lo-zoom {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.caption }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'lo-placeholder' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community cockpits",
  "class": "lo-section",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [
      { "value": "dark", "label": "Carbon" }, { "value": "white", "label": "White" }, { "value": "light", "label": "Light grey" }
    ], "default": "dark" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#leadoutcockpit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Community cockpits" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Share yours" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption", "info": "For example the rider's @handle." }
    ] }
  ],
  "presets": [{
    "name": "Community cockpits",
    "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
  }]
}
{% endschema %}
