{%- assign s = section.settings -%}
<section class="lo-reviews lo-scheme-{{ s.scheme }}">
  <div class="lo-wrap">
    <div class="lo-section-head" data-lo-reveal>
      {%- if s.eyebrow != blank -%}<p class="lo-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
    </div>
    <div class="lo-reviews__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="lo-reviews__app">{% render block %}</div>
          {%- when 'review' -%}
            <figure class="lo-review" data-lo-reveal {{ block.shopify_attributes }}>
              <div class="lo-review__stars" aria-label="{{ block.settings.rating }} / 5">
                {%- for i in (1..block.settings.rating) -%}{% render 'lo-icon', name: 'star' %}{%- endfor -%}
              </div>
              <blockquote>{{ block.settings.text }}</blockquote>
              <figcaption>{{ block.settings.author }}{% if block.settings.detail != blank %} <span>· {{ block.settings.detail }}</span>{% endif %}</figcaption>
            </figure>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "class": "lo-section",
  "settings": [
    { "type": "paragraph", "content": "Add the Judge.me widget with 'Add block › Apps', or add your own review blocks." },
    { "type": "select", "id": "scheme", "label": "Background", "options": [
      { "value": "white", "label": "White" }, { "value": "light", "label": "Light grey" }, { "value": "dark", "label": "Carbon" }
    ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Riders trust LEADOUT" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Review" },
      { "type": "text", "id": "author", "label": "Name" },
      { "type": "text", "id": "detail", "label": "Detail", "info": "For example the product or the rider's bike." }
    ] }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
