{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank and collection != blank
    assign source = collection
  endif
  if source == blank
    assign source = collections.all
  endif
  assign devices = shop.metaobjects.device.values
  assign bars = shop.metaobjects.bar_type.values
-%}
<section id="lo-finder" class="lo-finder lo-scheme-{{ s.scheme }}" data-lo-finder>
  <div class="lo-wrap">
    <div class="lo-finder__head" data-lo-reveal>
      {%- if s.eyebrow != blank -%}<p class="lo-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="lo-finder__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="lo-finder__text">{{ s.text }}</div>{%- endif -%}
    </div>

    <form class="lo-finder__form" data-lo-finder-form>
      <label class="lo-field">
        <span class="lo-field__label">{{ s.device_label }}</span>
        <select name="device" data-lo-device>
          <option value="">{{ s.device_placeholder }}</option>
          {%- liquid
            assign brand_list = ''
            for device in devices
              assign brand_list = brand_list | append: device.brand.value | append: '|'
            endfor
            assign brands = brand_list | split: '|' | uniq
          -%}
          {%- for brand in brands -%}
            <optgroup label="{{ brand | escape }}">
              {%- for device in devices -%}
                {%- if device.brand.value == brand -%}
                  <option value="{{ device.system.handle }}">{{ device.brand.value }} {{ device.model.value }}</option>
                {%- endif -%}
              {%- endfor -%}
            </optgroup>
          {%- endfor -%}
        </select>
      </label>
      <label class="lo-field">
        <span class="lo-field__label">{{ s.bar_label }}</span>
        <select name="bar" data-lo-bar>
          <option value="">{{ s.bar_placeholder }}</option>
          {%- for bar in bars -%}
            <option value="{{ bar.system.handle }}">{{ bar.name.value }}</option>
          {%- endfor -%}
        </select>
      </label>
      <button type="button" class="lo-btn lo-btn--ghost lo-finder__reset" data-lo-reset>{{ s.reset_label }}</button>
    </form>

    {%- if devices.size == 0 or bars.size == 0 -%}
      {%- if request.design_mode -%}
        <p class="lo-note">Add entries to the "Device" and "Bar type" metaobjects in Content › Metaobjects to fill these lists.</p>
      {%- endif -%}
    {%- endif -%}

    <p class="lo-finder__status" role="status" aria-live="polite" data-lo-status
      data-template="{{ s.results_label | escape }}" data-empty="{{ s.empty_label | escape }}"></p>

    {%- if s.show_results -%}
      <div class="lo-grid lo-grid--{{ s.columns }}" data-lo-results>
        {%- for product in source.products limit: s.limit -%}
          {% render 'lo-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'lo-compat.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Compatibility checker",
  "class": "lo-section",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [
      { "value": "light", "label": "Light grey" },
      { "value": "dark", "label": "Carbon" },
      { "value": "white", "label": "White" }
    ], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compatibility" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the mount that fits your setup" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose your device and handlebar. We'll only show what fits.</p>" },
    { "type": "text", "id": "device_label", "label": "Device label", "default": "Your device" },
    { "type": "text", "id": "device_placeholder", "label": "Device placeholder", "default": "Garmin, Wahoo, Hammerhead, GoPro…" },
    { "type": "text", "id": "bar_label", "label": "Handlebar label", "default": "Your handlebar" },
    { "type": "text", "id": "bar_placeholder", "label": "Handlebar placeholder", "default": "31.8 mm, 35 mm, integrated…" },
    { "type": "text", "id": "reset_label", "label": "Reset button", "default": "Reset" },
    { "type": "text", "id": "results_label", "label": "Results message", "default": "[count] mounts fit your setup", "info": "[count] is replaced with the number of products." },
    { "type": "text", "id": "empty_label", "label": "No results message", "default": "Nothing fits this combination yet. Message us and we'll help you choose." },
    { "type": "header", "content": "Results" },
    { "type": "checkbox", "id": "show_results", "label": "Show matching products below", "default": true },
    { "type": "collection", "id": "collection", "label": "Products to check", "info": "Leave empty to use the current collection, or all products." },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 4, "max": 50, "step": 1, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ], "default": "4" }
  ],
  "presets": [{ "name": "Compatibility checker" }]
}
{% endschema %}
