{%- liquid
  assign s = section.settings
  assign items = product.metafields.custom.complete_cockpit.value
  if items == blank and s.fallback != blank
    assign items = s.fallback.products
  endif
-%}
{%- if items != blank -%}
  <section class="lo-related lo-scheme-{{ s.scheme }}">
    <div class="lo-wrap">
      <div class="lo-section-head" data-lo-reveal>
        {%- if s.eyebrow != blank -%}<p class="lo-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
      <div class="lo-grid lo-grid--4">
        {%- for item in items limit: 4 -%}
          {%- unless item.id == product.id -%}{% render 'lo-card', product: item %}{%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Complete your cockpit",
  "class": "lo-section",
  "settings": [
    { "type": "paragraph", "content": "Shows the products in the product's 'Complete cockpit' metafield, or the fallback collection." },
    { "type": "select", "id": "scheme", "label": "Background", "options": [
      { "value": "white", "label": "White" }, { "value": "light", "label": "Light grey" }, { "value": "dark", "label": "Carbon" }
    ], "default": "light" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pairs well with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your cockpit" },
    { "type": "collection", "id": "fallback", "label": "Fallback collection" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Complete your cockpit" }]
}
{% endschema %}
