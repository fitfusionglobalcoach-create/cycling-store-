{%- assign s = section.settings -%}
<section class="lo-tiles lo-scheme-{{ s.scheme }}">
  <div class="lo-wrap">
    {%- if s.heading != blank -%}
      <div class="lo-section-head" data-lo-reveal>
        {%- if s.eyebrow != blank -%}<p class="lo-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="lo-tiles__grid lo-tiles__grid--{{ section.blocks.size | at_most: 5 }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="lo-tile" data-lo-zoom data-lo-reveal {{ block.shopify_attributes }}>
          <div class="lo-tile__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 20vw, 50vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'lo-placeholder' }}
            {%- endif -%}
          </div>
          <span class="lo-tile__title">{{ block.settings.title }}</span>
          {%- if block.settings.subtitle != blank -%}<span class="lo-tile__sub">{{ block.settings.subtitle }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by tiles",
  "class": "lo-section",
  "max_blocks": 10,
  "settings": [
    { "type": "select", "id": "scheme", "label": "Background", "options": [
      { "value": "white", "label": "White" }, { "value": "light", "label": "Light grey" }, { "value": "dark", "label": "Carbon" }
    ], "default": "white" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by device" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mounts for every computer" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Garmin" },
      { "type": "text", "id": "subtitle", "label": "Subtitle" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{
    "name": "Shop by tiles",
    "blocks": [
      { "type": "tile", "settings": { "title": "Garmin", "subtitle": "Edge" } },
      { "type": "tile", "settings": { "title": "Wahoo", "subtitle": "ELEMNT" } },
      { "type": "tile", "settings": { "title": "Hammerhead", "subtitle": "Karoo" } },
      { "type": "tile", "settings": { "title": "GoPro", "subtitle": "Action cams" } },
      { "type": "tile", "settings": { "title": "Lights", "subtitle": "Front lights" } }
    ]
  }]
}
{% endschema %}
