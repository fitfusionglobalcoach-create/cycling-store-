{%- assign product = closest.product -%}
<div class="lo-fits" data-lo-fits data-state="unknown" {% render 'lo-compat-data', product: product %} {{ block.shopify_attributes }}>
  <span class="lo-fits__msg lo-fits__msg--yes">✔ {{ settings.lo_fits_yes }}</span>
  <span class="lo-fits__msg lo-fits__msg--no">✕ {{ settings.lo_fits_no }}</span>
  <span class="lo-fits__msg lo-fits__msg--unknown">{{ settings.lo_fits_unknown }}</span>
  {%- if block.settings.link_label != blank -%}
    <a href="{{ block.settings.link | default: '/#lo-finder' }}" class="lo-fits__link">{{ block.settings.link_label }}</a>
  {%- endif -%}
</div>
<script src="{{ 'lo-compat.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "LEADOUT fits your setup",
  "settings": [
    { "type": "paragraph", "content": "Messages are edited in Theme settings › LEADOUT › Compatibility." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Change setup" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the checker on the home page." }
  ],
  "presets": [{ "name": "LEADOUT fits your setup" }]
}
{% endschema %}
